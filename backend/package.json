{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run test:unit",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --testMatch \"<rootDir>/test/unit/**/*.test.ts\"",
    "test:integration": "tsx test/setup/prepare-integration-db.ts && NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --testMatch \"<rootDir>/test/integration/**/*.test.ts\" --runInBand",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --coverage --testMatch \"<rootDir>/test/unit/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:setup": "prisma generate && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.2",
    "@types/pg": "^8.20.0",
    "jest": "^30.3.0",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
