generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Route {
  id                 BigInt   @id @default(autoincrement())
  originCity         String   @map("origin_city") @db.VarChar(120)
  destinationCity    String   @map("destination_city") @db.VarChar(120)
  distanceKm         Decimal  @map("distance_km") @db.Decimal(10, 2)
  estimatedTimeHours Decimal  @map("estimated_time_hours") @db.Decimal(8, 2)
  vehicleType        String   @map("vehicle_type") @db.VarChar(80)
  carrier            String   @db.VarChar(120)
  costUsd            Decimal  @map("cost_usd") @db.Decimal(12, 2)
  status             String   @default("ACTIVA") @db.VarChar(40)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("route")
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(40)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("user")
}

model Shipment {
  id                BigInt          @id @default(autoincrement())
  trackingNumber    String          @unique @map("tracking_number") @db.VarChar(40)
  recipient         String          @db.VarChar(160)
  origin            String          @db.VarChar(160)
  destination       String          @db.VarChar(160)
  status            ShipmentStatus
  estimatedDelivery DateTime        @map("estimated_delivery") @db.Date
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("shipment")
}

enum ShipmentStatus {
  ACTIVA
  INACTIVA
  SUSPENDIDA
  EN_MANTENIMIENTO
}
